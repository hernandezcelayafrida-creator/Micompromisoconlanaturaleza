   <cells rows="1" cols="3" cellWidth="200.0" cellHeight="60.0" border="true" id="acrossClues">
    <style />
    <shaper class="@Rectangular" cols="3" rows="1" />
    <cell id="11" item="2" />
    <cell id="11" item="1" />
    <cell id="11" item="0">
     <p>Lo que respiramos para vivir.</p>
    </cell>
    <cell id="10" item="2" />
    <cell id="10" item="1" />
    <cell id="10" item="0" />
    <cell id="9" item="3" />
    <cell id="9" item="2" />
    <cell id="9" item="1" />
    <cell id="9" item="0" />
    <cell id="8" item="3" />
    <cell id="8" item="2" />
    <cell id="8" item="1">
     <p>Ser vivo que debemos resoetar y cuidar.</p>
    </cell>
    <cell id="8" item="0" />
    <cell id="7" item="4" />
    <cell id="7" item="3" />
    <cell id="7" item="2" />
    <cell id="7" item="1" />
    <cell id="7" item="0" />
    <cell id="6" item="3" />
    <cell id="6" item="2" />
    <cell id="6" item="1" />
    <cell id="6" item="0" />
    <cell id="5" item="2" />
    <cell id="5" item="1" />
    <cell id="5" item="0" />
    <cell id="4" item="1" />
    <cell id="4" item="0">
     <p>planta grande que nos da sombra y oxigeno.</p>
    </cell>
    <cell id="3" item="3" />
    <cell id="3" item="2">
     <p>Lugar donde crecen los arboles.</p>
    </cell>
    <cell id="3" item="1" />
    <cell id="3" item="0" />
    <cell id="2" item="1" />
    <cell id="2" item="0" />
    <cell id="1" item="1" />
    <cell id="1" item="0" />
    <cell id="12" item="2" />
    <cell id="12" item="1" />
    <cell id="12" item="0" />
    <cell id="13" item="1" />
    <cell id="13" item="0">
     <p>Volver a utilizar un objeto.</p>
    </cell>
    <cell id="14" item="0" />
    <cell id="1" item="3" />
    <cell id="0" item="0" />
    <cell id="0" />
    <cell id="1" />
    <cell id="2" />
   </cells>
   <cells rows="1" cols="3" cellWidth="200.0" cellHeight="60.0" border="true" id="downClues">
    <style />
    <cell id="3" item="1" />
    <cell id="3" item="0">
     <p>Residuos que debemos tirara en su lugar.</p>
    </cell>
    <cell id="0" item="0" />
    <cell id="1" item="1" />
    <cell id="1" item="0">
     <p>Liquido que necesitamos para vivir.</p>
    </cell>
    <cell id="2" item="1" />
    <cell id="2" item="0" />
    <cell id="2" item="1" />
    <cell id="4" item="1" />
    <cell id="4" item="0" />
    <cell id="4" item="1" />
    <cell id="5" item="1" />
    <cell id="5" item="0">
     <p>Ser vivo que necesita agua y luz para crecer.</p>
    </cell>
    <cell id="5" item="1" />
    <cell id="6" item="2" />
    <cell id="6" item="1" />
    <cell id="6" item="0" />
    <cell id="6" item="2" />
    <cell id="7" item="1" />
    <cell id="7" item="0">
