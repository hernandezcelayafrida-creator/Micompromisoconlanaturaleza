   <textGrid rows="15" columns="15" cellWidth="20.0" cellHeight="20.0" border="true">
    <style>
     <color background="0xFFFFFF" />
    </style>
    <text>
     <row>PLANETA********</row>
     <row>***************</row>
     <row>****NATURALEZA*</row>
     <row>*************N*</row>
     <row>LIMPIEZA*****I*</row>
     <row>**A***A******M*</row>
     <row>**H***G*TIERRA*</row>
     <row>**O***U******L*</row>
     <row>**R***A******E*</row>
     <row>**R**********S*</row>
     <row>**O***ARBOL****</row>
     <row>***************</row>
     <row>*****RECICLAR**</row>
     <row>***************</row>
     <row>BASURA*********</row>
    </text>
   </textGrid>
   <clues>
    <clue id="0">PLANETA </clue>
    <clue id="1">AGUA</clue>
    <clue id="2">ARBOL</clue>
    <clue id="3">RECICLAR</clue>
    <clue id="4">TIERRA</clue>
    <clue id="5">LIMPIEZA</clue>
